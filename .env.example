# Database
DATABASE_URL=                  # PostgreSQL connection string (Supabase pooler)

# Auth
BETTER_AUTH_URL=               # Public URL of your app
BETTER_AUTH_SECRET=            # Random secret for signing sessions

# Storage (Tigris / S3-compatible)
AWS_ACCESS_KEY_ID=             # Tigris access key ID
AWS_SECRET_ACCESS_KEY=         # Tigris secret access key
AWS_ENDPOINT_URL=              # S3-compatible endpoint (e.g. https://t3.storage.dev)
AWS_BUCKET_NAME=               # Bucket name
AWS_REGION=                    # Region (use "auto" for Tigris)

# WakaTime
WAKATIME_API_KEY=              # WakaTime API key for coding stats
